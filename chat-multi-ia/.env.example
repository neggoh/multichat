# ── Banco de dados (PostgreSQL) ────────────────────────────────────────────────
# Ex.: postgresql://usuario:senha@localhost:5432/chat_multi_ia
DATABASE_URL=""

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Chave usada APENAS no servidor (app/api/chat). Gere em https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# ── URL pública da aplicação ──────────────────────────────────────────────────
# Usada nos metadados, no HTTP-Referer do OpenRouter e nas origens de dev.
NEXTAUTH_URL="http://localhost:3000"

# Origens extras liberadas no `next dev` (separadas por vírgula). Opcional.
# ALLOWED_DEV_ORIGINS="localhost,127.0.0.1"
