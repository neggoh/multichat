{
  "name": "multichat-windows",
  "productName": "MultiChat",
  "version": "1.1.2",
  "private": true,
  "description": "Aplicativo de desktop (Windows) para o Chat Multi-IA: conversa com os modelos gratuitos do OpenRouter sem precisar de servidor.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "pack": "electron-builder --dir",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js && node --check src/files.js"
  },
  "build": {
    "appId": "app.multichat.desktop",
    "productName": "MultiChat",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "sign": false,
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "MultiChat-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MultiChat-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdf-parse": "1.1.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
